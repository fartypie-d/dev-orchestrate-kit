#!/usr/bin/env python3
"""insane-fetch — command-line client for the shared bypass-fetch service.

Retrieves public content from sites that refuse plain HTTP clients, by
escalating through public endpoints, TLS-impersonated requests, and finally a
real headed browser. Works from any shell, any tool, any user on this host —
no Claude Code, no API key, no local browser install.

Examples:
    insane-fetch https://example.com/article
    insane-fetch https://spa.example/page --selector '.content' --text
    insane-fetch https://example.com --device mobile --json | jq .verdict

Exit codes:  0 retrieved  |  1 all routes failed  |  2 usage/transport error
"""
from __future__ import annotations

import argparse
import json
import os
import sys
import urllib.error
import urllib.request

DEFAULT_ENDPOINT = os.environ.get("INSANE_API_URL", "http://127.0.0.1:9223")


def main() -> int:
    p = argparse.ArgumentParser(
        prog="insane-fetch",
        description="Fetch a page through the shared insane-search bypass engine.",
    )
    p.add_argument("url", help="URL to fetch (http/https).")
    p.add_argument("-s", "--selector", action="append", dest="selectors", metavar="CSS",
                   help="Positive-proof CSS selector; repeatable. Strongly "
                        "recommended — it is how the engine tells a real page "
                        "from a challenge page.")
    p.add_argument("--device", choices=("auto", "desktop", "mobile"), default="auto")
    p.add_argument("--timeout", type=int, default=25, help="Per-attempt seconds (default 25).")
    p.add_argument("--max-attempts", type=int, default=None, help="Attempt budget (default: exhaustive).")
    p.add_argument("--no-browser", action="store_true", help="Skip the headed-browser fallback.")
    p.add_argument("--json", action="store_true", help="Emit the full result object.")
    p.add_argument("--text", action="store_true", help="Emit content only (default).")
    p.add_argument("--wrap", action="store_true",
                   help="Emit the untrusted-content envelope with the "
                        "prompt-injection verdict. Use when piping into an LLM.")
    p.add_argument("--endpoint", default=DEFAULT_ENDPOINT, help=f"Service URL (default {DEFAULT_ENDPOINT}).")
    p.add_argument("--trace", action="store_true", help="Print the attempt log to stderr.")
    args = p.parse_args()

    body = json.dumps({
        "url": args.url,
        "selectors": args.selectors,
        "device": args.device,
        "timeout": args.timeout,
        "max_attempts": args.max_attempts,
        "playwright": not args.no_browser,
        "wrap": args.wrap,
    }).encode("utf-8")

    req = urllib.request.Request(
        args.endpoint.rstrip("/") + "/fetch",
        data=body,
        headers={"Content-Type": "application/json"},
        method="POST",
    )
    # Generous: an exhaustive run can walk the whole grid and then launch a
    # browser. The service applies its own per-attempt timeouts.
    client_timeout = max(120, args.timeout * 12)
    try:
        with urllib.request.urlopen(req, timeout=client_timeout) as resp:
            payload = json.loads(resp.read().decode("utf-8"))
    except urllib.error.HTTPError as e:
        # 502 is a legitimate "all routes failed" answer and carries a body.
        try:
            payload = json.loads(e.read().decode("utf-8"))
        except Exception:
            print(f"insane-fetch: HTTP {e.code} {e.reason}", file=sys.stderr)
            return 2
    except urllib.error.URLError as e:
        print(f"insane-fetch: cannot reach {args.endpoint}: {e.reason}", file=sys.stderr)
        print("  is the service up?  (in containers/browser: docker compose ps)", file=sys.stderr)
        return 2

    if "error" in payload and "ok" not in payload:
        print(f"insane-fetch: {payload['error']}", file=sys.stderr)
        return 2

    if args.trace:
        for a in payload.get("trace", []):
            print(
                f"[{a['phase']:<8}] {a['executor']:<20} status={a['status']:>4} "
                f"size={a['body_size']:>8} verdict={a['verdict']} "
                f"{','.join(a.get('reasons') or [])}",
                file=sys.stderr,
            )
        print(f"=== {payload.get('summary', '')}", file=sys.stderr)

    if args.json:
        print(json.dumps(payload, ensure_ascii=False, indent=2))
    else:
        print(payload.get("untrusted_text") if args.wrap else payload.get("content", ""), end="")

    if not payload.get("ok"):
        risk = payload.get("stop_reason", "failed")
        print(f"\ninsane-fetch: not retrieved (stop_reason={risk})", file=sys.stderr)
        for route in payload.get("untried_routes") or []:
            print(f"  untried: {route}", file=sys.stderr)
        return 1
    return 0


if __name__ == "__main__":
    sys.exit(main())
